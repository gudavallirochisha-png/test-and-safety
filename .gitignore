# ==========================================
# Enterprise AI Trust & Safety Platform Gitignore
# ==========================================

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/
env/

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.output/
.nuxt/
dist/
.cache
.vite/

# Machine Learning Artifacts & Heavy Models
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.h5
*.keras
*.joblib
*.pkl
*.model
/models/*
!/models/README.md

# Datasets & Heavy Assets
/datasets/*
!/datasets/README.md
*.csv
*.parquet
*.feather
*.jsonl

# IDE & System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Logs
*.log
logs/
